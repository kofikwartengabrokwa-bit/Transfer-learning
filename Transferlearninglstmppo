# ============================================================
# PPO MASTER AND APPRENTICE AGENTS
# ============================================================

class ActorCritic(nn.Module):

    def __init__(self, state_dim, action_dim):

        super().__init__()

        # Actor network

        self.actor = nn.Sequential(
            nn.Linear(state_dim, 256),
            nn.ReLU(),

            nn.Linear(256,128),
            nn.ReLU(),

            nn.Linear(128, action_dim),
            nn.Softmax(dim=-1)
        )


        # Critic network

        self.critic = nn.Sequential(
            nn.Linear(state_dim,256),
            nn.ReLU(),

            nn.Linear(256,128),
            nn.ReLU(),

            nn.Linear(128,1)
        )


    def forward(self,state):

        action_prob = self.actor(state)

        value = self.critic(state)

        return action_prob,value



# ============================================================
# INITIALIZE MASTER AND APPRENTICE PPO
# ============================================================

ACTION_DIM = 3

master_agent = ActorCritic(
    state_dimension,
    ACTION_DIM
).to(DEVICE)



apprentice_agent = ActorCritic(
    state_dimension,
    ACTION_DIM
).to(DEVICE)



# ============================================================
# SOFT PARAMETER TRANSFER FROM MASTER TO APPRENTICE
# ============================================================

def soft_update(
        source,
        target,
        tau=0.005):


    for source_param, target_param in zip(
        source.parameters(),
        target.parameters()
    ):

        target_param.data.copy_(
            tau * source_param.data
            +
            (1-tau) *
            target_param.data
        )



# ============================================================
# RESOURCE ALLOCATION DECISION
# ============================================================

def select_action(agent,state):


    action_probability, value = agent(
        state
    )


    distribution = torch.distributions.Categorical(
        action_probability
    )


    action = distribution.sample()


    log_probability = distribution.log_prob(
        action
    )


    return (
        action,
        log_probability,
        value
    )



# ============================================================
# MASTER-APPRENTICE TRAINING PIPELINE
# ============================================================

TAU = 0.005

EPISODE=10
for episode in range(EPISODE):


    # -------------------------------
    # LSTM predicted network state
    # -------------------------------

    state = lstm_output[
        episode % len(lstm_output)
    ].unsqueeze(0)



    # -------------------------------
    # Master PPO decision
    # -------------------------------

    master_action, \
    master_log_prob, \
    master_value = select_action(
        master_agent,
        state
    )


    # Resource allocation action:
    # RB allocation,
    # bandwidth allocation,
    # transmission power


    master_resource_action = master_action



    # -------------------------------
    # Transfer master knowledge
    # -------------------------------

    soft_update(
        master_agent,
        apprentice_agent,
        tau=TAU
    )



    # -------------------------------
    # Apprentice PPO adaptation
    # -------------------------------

    apprentice_action, \
    apprentice_log_prob, \
    apprentice_value = select_action(
        apprentice_agent,
        state
    )



    apprentice_resource_action = (
        apprentice_action
    )



    print(
        f"Episode {episode+1}: "
        f"Master Action={master_resource_action.item()} | "
        f"Apprentice Action={apprentice_resource_action.item()}"
    )
