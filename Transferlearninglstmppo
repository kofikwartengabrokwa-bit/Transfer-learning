class LSTM_Model(nn.Module):

    def __init__(self):

        super().__init__()

        self.lstm = nn.LSTM(
            INPUT_SIZE,
            HIDDEN_SIZE,
            NUM_LAYERS,
            batch_first=True
        )


        self.fc = nn.Linear(
            HIDDEN_SIZE,
            OUTPUT_SIZE
        )


    def forward(self,x):

        out,_ = self.lstm(x)

        out = out[:,-1,:]

        return self.fc(out)



