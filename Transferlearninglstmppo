criterion = nn.MSELoss()


def evaluate_model(model, loader):

    model.eval()

    total_loss = 0

    with torch.no_grad():

        for X, y in loader:

            X = X.to(DEVICE)
            y = y.to(DEVICE)

            pred = model(X)

            loss = criterion(
                pred,
                y
            )

            total_loss += loss.item()


    return total_loss / len(loader)



