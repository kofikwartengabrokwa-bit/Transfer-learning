class ORAN_LSTM(nn.Module):

    def __init__(
        self,
        input_size,
        hidden_size,
        num_layers,
        dropout
    ):

        super(ORAN_LSTM, self).__init__()


        self.lstm = nn.LSTM(
            input_size=input_size,
            hidden_size=hidden_size,
            num_layers=num_layers,
            batch_first=True,
            dropout=dropout
        )


        self.dropout = nn.Dropout(dropout)


        self.fc = nn.Linear(
            hidden_size,
            input_size
        )


    def forward(self, x):

        output, (hidden, cell) = self.lstm(x)


        # last temporal state

        output = output[:, -1, :]


        output = self.dropout(output)


        prediction = self.fc(output)


        return prediction


