from difflib import SequenceMatcher


def fuzzy_match(column, keywords):

    column = column.lower()

    for k in keywords:

        if k.lower() in column:
            return True

    return False



def standardize_kpis(df):

    rename = {}


    for col in df.columns:


        # Radio KPIs

        if fuzzy_match(col,
                       ["cqi"]):
            rename[col] = "CQI"


        elif fuzzy_match(col,
                         ["mcs"]):
            rename[col] = "MCS"


        elif fuzzy_match(col,
                         ["prb",
                          "resourceblock",
                          "resource_block"]):
            rename[col] = "PRBs"


        elif fuzzy_match(col,
                         ["rsrp"]):
            rename[col] = "RSRP"


        elif fuzzy_match(col,
                         ["rsrq"]):
            rename[col] = "RSRQ"


        elif fuzzy_match(col,
                         ["sinr"]):
            rename[col] = "SINR"


        elif fuzzy_match(col,
                         ["bler"]):
            rename[col] = "BLER"


        elif fuzzy_match(col,
                         ["delay",
                          "latency"]):
            rename[col] = "Packet_Delay"


        elif fuzzy_match(col,
                         ["buffer",
                          "queue"]):
            rename[col] = "Buffer"



        # Cloud/O-DU KPIs

        elif fuzzy_match(col,
                         ["cpu"]):
            rename[col] = "CPU_Load"


        elif fuzzy_match(col,
                         ["power",
                          "energy"]):
            rename[col] = "Power"


        elif fuzzy_match(col,
                         ["rx",
                          "receive"]):
            rename[col] = "Network_RX"


        elif fuzzy_match(col,
                         ["tx",
                          "transmit"]):
            rename[col] = "Network_TX"



    df = df.rename(
        columns=rename
    )


    return df



