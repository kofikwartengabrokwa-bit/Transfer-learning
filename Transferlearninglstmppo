def create_sequences(data, seq_length):

    X = []
    Y = []


    for i in range(
        len(data)-seq_length
    ):

        X.append(
            data[i:i+seq_length]
        )

        Y.append(
            data[i+seq_length]
        )


    return (
        np.array(X),
        np.array(Y)
    )



