def inspect_tb_capacity(scheduler, ue_id, prbs):
    scheduler.PRBs = prbs
    scheduler.nrbUEmax = prbs

    ue = scheduler.ues[ue_id]

    # Ensure the UE uses the allocated PRBs
    ue.prbs = prbs
    ue.symb = scheduler.TDDsmb

    # Obtain the MCS/TBS information used by Py5cheSim
    result = scheduler.setMod(ue_id, prbs)

    return result


