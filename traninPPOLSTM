print(f"uRLLC RX normalization     : {MAX_URLLC_RX:.0f} bytes")

# ------------------------------------------------------------
# REWARD FUNCTION
# ------------------------------------------------------------

def calculate_ppo_reward(
    embb_rx,
    urllc_rx,
    embb_loss,
    urllc_loss,
    beta=BETA
):
    """
    Calculate service-aware PPO reward.

    Throughput utility:
        xi_e = eMBB received bytes / reference eMBB bytes
        xi_u = uRLLC received bytes / reference uRLLC bytes

    QoS:
        Q_e = 1 - eMBB packet loss
        Q_u = 1 - uRLLC packet loss

    Slice rewards:
        R_e = 0.5*xi_e + 0.5*Q_e
        R_u = 0.5*xi_u + 0.5*Q_u

    Overall reward:
        R = beta*R_e + (1-beta)*R_u
    """

    # Throughput utilities
    embb_utility = np.clip(
        float(embb_rx) / MAX_EMBB_RX,
        0.0,
        1.0
    )

    urllc_utility = np.clip(
        float(urllc_rx) / MAX_URLLC_RX,
        0.0,
        1.0
    )

    # QoS satisfaction
    embb_qos = np.clip(
        1.0 - float(embb_loss) / 100.0,
        0.0,
        1.0
    )

    urllc_qos = np.clip(
        1.0 - float(urllc_loss) / 100.0,
        0.0,
        1.0
    )

    # Individual service rewards
    embb_reward = (
        0.5 * embb_utility +
        0.5 * embb_qos
    )

    urllc_reward = (
        0.5 * urllc_utility +
        0.5 * urllc_qos
    )

    # Service-aware overall reward
    total_reward = (
        beta * embb_reward +
        (1.0 - beta) * urllc_reward
    )

    return {
        "embb_utility": embb_utility,
        "urllc_utility": urllc_utility,
        "embb_qos": embb_qos,
        "urllc_qos": urllc_qos,
        "embb_reward": embb_reward,
        "urllc_reward": urllc_reward,
        "total_reward": total_reward,
    }


