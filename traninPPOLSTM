    total_prbs = embb_prbs + urllc_prbs

    if total_prbs != 52:
        raise ValueError(
            f"Invalid allocation: eMBB={embb_prbs}, "
            f"uRLLC={urllc_prbs}, total={total_prbs}. "
            f"Expected total = 52 PRBs."
        )

    # Update slice configurations
    cell.interSliceSched.slices["eMBB-0"].updateConfig(embb_prbs)
    cell.interSliceSched.slices["URLLC-0"].updateConfig(urllc_prbs)

    # Update scheduler references
    embb_sched.PRBs = embb_prbs
    embb_sched.nrbUEmax = embb_prbs

    urllc_sched.PRBs = urllc_prbs
    urllc_sched.nrbUEmax = urllc_prbs


