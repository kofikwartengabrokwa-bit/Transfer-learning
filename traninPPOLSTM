class O_RAN_Py5cheSim_Env:

    def __init__(
        self,
        cell,
        embb_sched,
        urllc_sched,
        beta=0.60,
        embb_users=10,
        urllc_users=10,
        sim_time=100,
        meas_interval=100
    ):
        self.cell = cell
        self.embb_sched = embb_sched
        self.urllc_sched = urllc_sched

        self.beta = beta
        self.embb_users = embb_users
        self.urllc_users = urllc_users

        self.sim_time = sim_time
        self.meas_interval = meas_interval

        self.state_dim = PPO_STATE_DIM
        self.action_dim = PPO_ACTION_DIM

        self.current_state = np.zeros(
            self.state_dim,
            dtype=np.float32
        )

    # --------------------------------------------------------
    # Reset scheduler state
    # --------------------------------------------------------
    def _reset_schedulers(self):

        self.embb_sched.queue.res.clear()
        self.urllc_sched.queue.res.clear()

        self.embb_sched.ind_u = 0
        self.urllc_sched.ind_u = 0

        self.embb_sched.ueLst = []
        self.urllc_sched.ueLst = []

        self.embb_sched.ues.clear()
        self.urllc_sched.ues.clear()

    # --------------------------------------------------------
    # Apply PPO action
    # --------------------------------------------------------
    def _apply_action(self, action):

        if action not in ACTION_TO_PRBS:
            raise ValueError(
                f"Invalid PPO action: {action}"
            )

        embb_prbs, urllc_prbs = ACTION_TO_PRBS[action]

        set_slice_prbs(
            embb_prbs,
            urllc_prbs
        )

        return embb_prbs, urllc_prbs

    # --------------------------------------------------------
    # Create fresh Py5cheSim simulation
    # --------------------------------------------------------
    def _create_simulation(self, action):

        embb_prbs, urllc_prbs = self._apply_action(action)

        env = simpy.Environment()

        activation_time = 0
        deactivation_time = 1

        # ----------------------------------------------------
        # Fresh eMBB users
        # ----------------------------------------------------
        embb_group = UEgroup(
            self.embb_users,
            0,
            300,
            300,
            1,
            1,
            activation_time,
            deactivation_time,
            "Constant",
            "Exponential",
            "eMBB-0",
            1,
            0.99,
            "Rr",
            "SU",
            1,
            self.cell,
            self.sim_time,
            self.meas_interval,
            env,
            "S10"
        )

        # ----------------------------------------------------
        # Fresh uRLLC users
        # ----------------------------------------------------
        urllc_group = UEgroup(
            self.urllc_users,
            0,
            300,
            300,
            1,
            1,
            activation_time,
            deactivation_time,
            "Constant",
            "Exponential",
            "URLLC-0",
            1,
            0.99,
            "Rr",
            "SU",
            1,
            self.cell,
            self.sim_time,
            self.meas_interval,
            env,
            "S10"
        )

        # UEgroup.initializeUEs() already starts:
        #   - packet generation
        #   - UE reception
        #   - radio-link updates
        #
        # Therefore, these processes must NOT be started again.

        # Start only the scheduler processes.
        env.process(
            self.embb_sched.queuesOut(env)
        )

        env.process(
            self.urllc_sched.queuesOut(env)
        )

        return (
            env,
            embb_group,
            urllc_group,
            embb_prbs,
            urllc_prbs
        )

    # --------------------------------------------------------
    # Collect simulation results
    # --------------------------------------------------------
    def _collect_results(
        self,
        embb_group,
        urllc_group
    ):

        def collect(users):

            rx = 0
            sent = 0
            lost = 0

            for ue in users:

                if len(ue.packetFlows) == 0:
                    continue

                flow = ue.packetFlows[0]

                rx += int(flow.rcvdBytes)
                sent += int(flow.sentPackets)
                lost += int(flow.lostPackets)

            if sent > 0:
                loss = 100.0 * lost / sent
            else:
                loss = 0.0

            return (
                rx,
                sent,
                lost,
                loss
            )

        (
            embb_rx,
            embb_sent,
            embb_lost,
            embb_loss
        ) = collect(embb_group.usersDL)

        (
            urllc_rx,
            urllc_sent,
            urllc_lost,
            urllc_loss
        ) = collect(urllc_group.usersDL)

        return {
            "embb_rx": embb_rx,
            "urllc_rx": urllc_rx,
            "embb_sent": embb_sent,
            "urllc_sent": urllc_sent,
            "embb_lost": embb_lost,
            "urllc_lost": urllc_lost,
            "embb_loss": embb_loss,
            "urllc_loss": urllc_loss
        }

    # --------------------------------------------------------
    # Reset environment
    # --------------------------------------------------------
    def reset(self, state=None):

        if state is None:

            self.current_state = np.zeros(
                self.state_dim,
                dtype=np.float32
            )

        else:

            self.current_state = np.asarray(
                state,
                dtype=np.float32
            )

        return self.current_state.copy()

    # --------------------------------------------------------
    # PPO step
    # --------------------------------------------------------
    def step(self, action):

        self._reset_schedulers()

        (
            sim_env,
            embb_group,
            urllc_group,
            embb_prbs,
            urllc_prbs
        ) = self._create_simulation(action)

        # Run Py5cheSim
        sim_env.run(
            until=self.sim_time
        )

        # Collect simulation statistics
        results = self._collect_results(
