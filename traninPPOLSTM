# ------------------------------------------------------------
# Replace reset() with LSTM-aware reset
# ------------------------------------------------------------

def _reset_with_lstm(self, history=None):

    if history is None:

        history = np.zeros(
            (
                LSTM_SEQUENCE_LENGTH,
                LSTM_INPUT_SIZE
            ),
            dtype=np.float32
        )

    history = np.asarray(
        history,
        dtype=np.float32
    )

    if history.shape != (
        LSTM_SEQUENCE_LENGTH,
        LSTM_INPUT_SIZE
    ):
        raise ValueError(
            f"Expected history shape "
            f"({LSTM_SEQUENCE_LENGTH}, "
            f"{LSTM_INPUT_SIZE}), "
            f"got {history.shape}"
        )

    # Store historical sequence for future updates
    self.state_history = history.copy()

    # Generate initial predicted state
    self.current_state = self.predict_lstm_state(
        self.state_history
    )

    return self.current_state.copy()


# ------------------------------------------------------------
# Replace step() with LSTM-state-aware step
# ------------------------------------------------------------

def _step_with_lstm(self, action):

    # --------------------------------------------------------
    # Run the validated Py5cheSim simulation
    # --------------------------------------------------------

    self._reset_schedulers()

    (
        sim_env,
        embb_group,
        urllc_group,
        embb_prbs,
        urllc_prbs
    ) = self._create_simulation(action)

    sim_env.run(
        until=self.sim_time
    )

    # --------------------------------------------------------
    # Collect simulation results
    # --------------------------------------------------------

    results = self._collect_results(
        embb_group,
        urllc_group
    )

    # --------------------------------------------------------
    # Calculate reward
    # --------------------------------------------------------

    reward_info = calculate_ppo_reward(
        results["embb_rx"],
        results["urllc_rx"],
        results["embb_loss"],
        results["urllc_loss"],
        beta=self.beta
    )

    reward = reward_info["total_reward"]

    # --------------------------------------------------------
    # Update LSTM history
    #
    # The current history is shifted by one observation.
    # For this validation stage, the newly observed state is
    # represented by the current predicted state.
    #
    # The actual measured network-state vector will be inserted
    # here once the Py5cheSim KPI mapping is finalized.
    # --------------------------------------------------------

    if not hasattr(self, "state_history"):

        self.state_history = np.zeros(
            (
                LSTM_SEQUENCE_LENGTH,
                LSTM_INPUT_SIZE
            ),
            dtype=np.float32
        )

    new_observation = self.current_state.copy()

    self.state_history = np.concatenate(
        [
            self.state_history[1:],
            new_observation.reshape(1, -1)
        ],
        axis=0
    )

    # --------------------------------------------------------
    # Predict next state using LSTM
    # --------------------------------------------------------

    next_state = self.predict_lstm_state(
        self.state_history
    )

    self.current_state = next_state.copy()

    done = False

    # --------------------------------------------------------
    # Information returned to PPO
    # --------------------------------------------------------

    info = {
        "action": action,

        "embb_prbs": embb_prbs,
        "urllc_prbs": urllc_prbs,

        "embb_rx": results["embb_rx"],
        "urllc_rx": results["urllc_rx"],

        "embb_loss": results["embb_loss"],
        "urllc_loss": results["urllc_loss"],

        "embb_sent": results["embb_sent"],
        "urllc_sent": results["urllc_sent"],

        "embb_lost": results["embb_lost"],
        "urllc_lost": results["urllc_lost"],

        "embb_reward": reward_info["embb_reward"],
        "urllc_reward": reward_info["urllc_reward"],

        "lstm_state": next_state.copy()
    }

    return (
        next_state,
        reward,
        done,
        info
    )


