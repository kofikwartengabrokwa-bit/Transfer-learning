def collect_flow_statistics(user_group):
    sent = 0
    received_bytes = 0
    lost = 0

    for ue in user_group.usersDL:
        for flow in ue.packetFlows:
            sent += flow.sentPackets
            received_bytes += flow.rcvdBytes
            lost += flow.lostPackets

    return sent, received_bytes, lost


