class O_RAN_Py5cheSim_Env:

    def __init__(
        self,
        cell,
        embb_sched,
        urllc_sched,
        beta=0.60,
        embb_users=10,
        urllc_users=10,
        sim_time=100,
        measurement_interval=100,
    ):

        self.cell = cell
        self.embb_sched = embb_sched
        self.urllc_sched = urllc_sched

        self.beta = beta
        self.embb_users = embb_users
        self.urllc_users = urllc_users
        self.sim_time = sim_time
        self.measurement_interval = measurement_interval

        self.state_dim = PPO_STATE_DIM
        self.action_dim = PPO_ACTION_DIM

        self.current_state = np.zeros(
            self.state_dim,
            dtype=np.float32
        )

    # ------------------------------------------------------------------
    # Reset scheduler state
    # ------------------------------------------------------------------
    def _reset_schedulers(self):

        self.embb_sched.queue.res.clear()
        self.urllc_sched.queue.res.clear()

        self.embb_sched.ind_u = 0
        self.urllc_sched.ind_u = 0

        self.embb_sched.ueLst = []
        self.urllc_sched.ueLst = []

        self.embb_sched.ues.clear()
        self.urllc_sched.ues.clear()

    # ------------------------------------------------------------------
    # Apply PPO action
    # ------------------------------------------------------------------
    def _apply_action(self, action):

        if action not in ACTION_TO_PRBS:
            raise ValueError(
                f"Invalid PPO action: {action}"
            )

        embb_prbs, urllc_prbs = apply_ppo_action(
            action
        )

        return embb_prbs, urllc_prbs

    # ------------------------------------------------------------------
    # Create fresh Py5cheSim simulation
    # ------------------------------------------------------------------
    def _create_simulation(self, action):

        embb_prbs, urllc_prbs = self._apply_action(
            action
        )

        env = simpy.Environment()

        # --------------------------------------------------------------
        # IMPORTANT:
        # Py5cheSim expects activation/deactivation values
        # normalized to [0, 1].
        #
        # 0 -> active from the beginning
        # 1 -> active through the simulation period
        # --------------------------------------------------------------

        activation_time = 0
        deactivation_time = 1

        # --------------------------------------------------------------
        # eMBB UE group
        # --------------------------------------------------------------

        embb_group = UEgroup(
            self.embb_users,
            0,
            300,
            300,
            1,
            1,
            activation_time,
            deactivation_time,
            "Constant",
            "Exponential",
            "eMBB-0",
            1,
            0.99,
            "RR",
            "SU",
            1,
            self.cell,
            self.sim_time,
            self.measurement_interval,
            env,
            str(TEST_SINR),
        )

        # --------------------------------------------------------------
        # uRLLC UE group
        # --------------------------------------------------------------

        urllc_group = UEgroup(
            self.urllc_users,
            0,
            300,
            300,
            1,
            1,
            activation_time,
            deactivation_time,
            "Constant",
            "Exponential",
            "URLLC-0",
            1,
            0.99,
            "RR",
            "SU",
            1,
            self.cell,
            self.sim_time,
            self.measurement_interval,
            env,
            str(TEST_SINR),
        )

        return (
            env,
            embb_group,
            urllc_group,
            embb_prbs,
            urllc_prbs,
        )

    # ------------------------------------------------------------------
    # Collect simulation results
    # ------------------------------------------------------------------
    def _collect_results(
        self,
        embb_group,
        urllc_group,
    ):

        embb_rx = 0
        urllc_rx = 0

        embb_lost = 0
        urllc_lost = 0

        embb_sent = 0
        urllc_sent = 0

        for ue in embb_group.usersDL:

            if len(ue.packetFlows) > 0:

                flow = ue.packetFlows[0]

                embb_rx += int(
                    getattr(
                        flow,
                        "rcvdBytes",
                        0
                    )
                )

                embb_lost += int(
                    getattr(
                        flow,
                        "lostPackets",
                        0
                    )
                )

                embb_sent += int(
                    getattr(
                        flow,
                        "sentPackets",
                        0
                    )
                )

        for ue in urllc_group.usersDL:

            if len(ue.packetFlows) > 0:

                flow = ue.packetFlows[0]

                urllc_rx += int(
                    getattr(
                        flow,
                        "rcvdBytes",
                        0
                    )
                )

                urllc_lost += int(
                    getattr(
                        flow,
                        "lostPackets",
                        0
                    )
                )

                urllc_sent += int(
                    getattr(
                        flow,
                        "sentPackets",
                        0
                    )
                )

        if embb_sent > 0:
            embb_loss = (
                100.0 * embb_lost / embb_sent
            )
        else:
            embb_loss = 0.0

        if urllc_sent > 0:
            urllc_loss = (
                100.0 * urllc_lost / urllc_sent
            )
        else:
            urllc_loss = 0.0

        return {
            "embb_rx": embb_rx,
            "urllc_rx": urllc_rx,
            "embb_loss": embb_loss,
            "urllc_loss": urllc_loss,
            "embb_sent": embb_sent,
            "urllc_sent": urllc_sent,
            "embb_lost": embb_lost,
            "urllc_lost": urllc_lost,
        }

    # ------------------------------------------------------------------
    # Reset
    # ------------------------------------------------------------------
    def reset(self, state=None):

        self._reset_schedulers()

        if state is None:

            self.current_state = np.zeros(
                self.state_dim,
                dtype=np.float32
            )

        else:

            state = np.asarray(
                state,
                dtype=np.float32
            )

            if state.shape != (
                self.state_dim,
            ):

                raise ValueError(
                    f"Expected state shape "
                    f"({self.state_dim},), "
                    f"got {state.shape}"
                )

            self.current_state = state.copy()

        return self.current_state.copy()

    # ------------------------------------------------------------------
    # PPO step
    # ------------------------------------------------------------------
    def step(self, action):

        self._reset_schedulers()

        (
            env,
            embb_group,
            urllc_group,
            embb_prbs,
            urllc_prbs,
        ) = self._create_simulation(action)

        # --------------------------------------------------------------
        # Start native packet generators
        # --------------------------------------------------------------

        for flow in embb_group.flowsDL:

            env.process(
                flow.queueAppPckt(
                    env,
                    self.sim_time
                )
            )

        for flow in urllc_group.flowsDL:

            env.process(
                flow.queueAppPckt(
                    env,
                    self.sim_time
                )
            )

        # --------------------------------------------------------------
        # Start UE receive processes
        # --------------------------------------------------------------

        for ue in embb_group.usersDL:

            env.process(
                ue.receivePckt(
                    env,
                    self.cell
                )
            )

        for ue in urllc_group.usersDL:

            env.process(
                ue.receivePckt(
                    env,
                    self.cell
                )
            )

        # --------------------------------------------------------------
        # Start native schedulers
        # --------------------------------------------------------------

        env.process(
            self.embb_sched.queuesOut(
                env
            )
        )

        env.process(
            self.urllc_sched.queuesOut(
                env
            )
        )

        # --------------------------------------------------------------
        # Run Py5cheSim
        # --------------------------------------------------------------

        env.run(
            until=self.sim_time
        )

        # --------------------------------------------------------------
        # Collect results
        # --------------------------------------------------------------

        results = self._collect_results(
            embb_group,
            urllc_group
        )

        # --------------------------------------------------------------
        # Calculate PPO reward
        # --------------------------------------------------------------

        reward_info = calculate_ppo_reward(
            results["embb_rx"],
            results["urllc_rx"],
            results["embb_loss"],
            results["urllc_loss"],
            beta=self.beta,
        )

        reward = float(
            reward_info["total_reward"]
        )

        # --------------------------------------------------------------
        # LSTM state integration will be added later.
        # --------------------------------------------------------------

        next_state = self.current_state.copy()

        done = False

        info = {
            "action": int(action),

            "embb_prbs": int(embb_prbs),
            "urllc_prbs": int(urllc_prbs),

            "embb_rx": results["embb_rx"],
            "urllc_rx": results["urllc_rx"],

            "embb_loss": results["embb_loss"],
            "urllc_loss": results["urllc_loss"],

            "embb_sent": results["embb_sent"],
            "urllc_sent": results["urllc_sent"],

            "embb_lost": results["embb_lost"],
            "urllc_lost": results["urllc_lost"],

            "embb_reward": reward_info["embb_reward"],
            "urllc_reward": reward_info["urllc_reward"],
        }

        return (
            next_state,
            reward,
            done,
            info,
        )


