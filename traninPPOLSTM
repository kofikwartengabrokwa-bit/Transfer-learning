# ------------------------------------------------------------
# 3. Define environment class
# ------------------------------------------------------------
class O_RAN_Py5cheSim_Env:

    def __init__(
        self,
        cell,
        embb_sched,
        urllc_sched,
        beta=0.60,
        embb_users=10,
        urllc_users=10,
        sim_time=100,
        measurement_interval=100
    ):

        self.cell = cell

        self.embb_sched = embb_sched
        self.urllc_sched = urllc_sched

        self.beta = beta

        self.embb_user_count = embb_users
        self.urllc_user_count = urllc_users

        self.sim_time = sim_time
        self.measurement_interval = measurement_interval

        self.state_dim = PPO_STATE_DIM
        self.action_dim = PPO_ACTION_DIM

        self.current_state = None
        self.last_action = None

        self.last_result = None


    # --------------------------------------------------------
    # Reset scheduler state
    # --------------------------------------------------------
    def _reset_schedulers(self):

        for sched in [
            self.embb_sched,
            self.urllc_sched
        ]:

            sched.queue.res.clear()
            sched.ind_u = 0
            sched.ueLst = []
            sched.ues.clear()


    # --------------------------------------------------------
    # Apply PPO action
    # --------------------------------------------------------
    def _apply_action(self, action):

        if action not in ACTION_TO_PRBS:
            raise ValueError(
                f"Invalid PPO action: {action}"
            )

        embb_prbs, urllc_prbs = ACTION_TO_PRBS[action]

        set_slice_prbs(
            embb_prbs,
            urllc_prbs
        )

        return embb_prbs, urllc_prbs


    # --------------------------------------------------------
    # Reset environment
    # --------------------------------------------------------
    def reset(self, state=None):

        self._reset_schedulers()

        if state is None:

            state = np.zeros(
                self.state_dim,
                dtype=np.float32
            )

        state = np.asarray(
            state,
            dtype=np.float32
        )

        if state.shape != (self.state_dim,):

            raise ValueError(
                f"Expected state shape "
                f"({self.state_dim},), "
                f"got {state.shape}"
            )

        self.current_state = state

        self.last_action = None
        self.last_result = None

        return self.current_state.copy()


    # --------------------------------------------------------
    # Step interface
    #
    # Actual Py5cheSim execution will be connected next.
    # --------------------------------------------------------
    def step(self, action):

        if self.current_state is None:

            raise RuntimeError(
                "Environment must be reset before step()."
            )

        embb_prbs, urllc_prbs = self._apply_action(
            int(action)
        )

        self.last_action = int(action)

        result = {
            "action": int(action),
            "embb_prbs": embb_prbs,
            "urllc_prbs": urllc_prbs
        }

        self.last_result = result

        return (
