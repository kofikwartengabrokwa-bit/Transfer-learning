# ============================================================
# PPO UPDATE METHOD
# ============================================================

def ppo_update(
    agent,
    buffer,
    gamma=PPO_GAMMA,
    gae_lambda=PPO_GAE_LAMBDA,
    clip_eps=PPO_CLIP,
    ppo_epochs=PPO_EPOCHS,
    entropy_coef=PPO_ENTROPY_COEF,
    value_coef=PPO_VALUE_COEF
):

    if len(buffer) == 0:
        raise ValueError(
            "PPO buffer is empty."
        )

    # --------------------------------------------------------
    # Convert rollout data to tensors
    # --------------------------------------------------------

    states = torch.tensor(
        np.asarray(
            buffer.states,
            dtype=np.float32
        ),
        dtype=torch.float32,
        device=DEVICE
    )

    actions = torch.tensor(
        np.asarray(
            buffer.actions,
            dtype=np.int64
        ),
        dtype=torch.long,
        device=DEVICE
    )

    old_log_probs = torch.tensor(
        np.asarray(
            buffer.log_probs,
            dtype=np.float32
        ),
        dtype=torch.float32,
        device=DEVICE
    )

    rewards = np.asarray(
        buffer.rewards,
        dtype=np.float32
    )

    dones = np.asarray(
        buffer.dones,
        dtype=np.float32
    )

    values = np.asarray(
        buffer.values,
        dtype=np.float32
    )

    # --------------------------------------------------------
    # Bootstrap value
    # --------------------------------------------------------

    if buffer.dones[-1]:

        next_value = 0.0

    else:

        with torch.no_grad():

            next_state = states[-1].unsqueeze(0)

            next_value = float(
                agent.critic(
                    next_state
                ).item()
            )

    # --------------------------------------------------------
    # Compute GAE
    # --------------------------------------------------------

    advantages, returns = compute_gae(
        rewards=buffer.rewards,
        values=buffer.values,
        dones=buffer.dones,
        next_value=next_value,
        gamma=gamma,
        gae_lambda=gae_lambda
    )

    advantages = torch.tensor(
        advantages,
        dtype=torch.float32,
        device=DEVICE
    )

    returns = torch.tensor(
        returns,
        dtype=torch.float32,
        device=DEVICE
    )

    # --------------------------------------------------------
    # Normalize advantages
    # --------------------------------------------------------

    if len(advantages) > 1:

        advantages = (
            advantages
            - advantages.mean()
        ) / (
            advantages.std(
                unbiased=False
            ) + 1e-8
        )

    # --------------------------------------------------------
    # PPO optimization
    # --------------------------------------------------------

    actor_losses = []
    critic_losses = []
    entropy_values = []
    total_losses = []

    for _ in range(
        ppo_epochs
    ):

        # ----------------------------------------------------
        # Current policy
        # ----------------------------------------------------

        distribution = (
            agent.actor.distribution(
                states
            )
        )

        new_log_probs = (
            distribution.log_prob(
                actions
            )
        )

        entropy = (
            distribution.entropy()
            .mean()
        )

        # ----------------------------------------------------
        # Probability ratio
        # ----------------------------------------------------

        ratios = torch.exp(
            new_log_probs
            - old_log_probs
        )

        # ----------------------------------------------------
        # Clipped PPO objective
        # ----------------------------------------------------

        unclipped_objective = (
            ratios
            * advantages
        )

        clipped_objective = (
            torch.clamp(
                ratios,
                1.0 - clip_eps,
                1.0 + clip_eps
            )
            * advantages
        )

        actor_loss = -torch.min(
            unclipped_objective,
            clipped_objective
        ).mean()

        # ----------------------------------------------------
        # Critic loss
        # ----------------------------------------------------

        predicted_values = (
            agent.critic(
                states
            )
        )

        critic_loss = (
            nn.functional.mse_loss(
                predicted_values,
                returns
            )
        )

        # ----------------------------------------------------
        # Actor update
        # ----------------------------------------------------

        agent.actor_optimizer.zero_grad()

        actor_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            agent.actor.parameters(),
            max_norm=1.0
        )

        agent.actor_optimizer.step()

        # ----------------------------------------------------
        # Critic update
        # ----------------------------------------------------

        agent.critic_optimizer.zero_grad()

        critic_loss.backward()

        torch.nn.utils.clip_grad_norm_(
            agent.critic.parameters(),
            max_norm=1.0
        )

        agent.critic_optimizer.step()

        # ----------------------------------------------------
        # Record statistics
        # ----------------------------------------------------

        total_loss = (
            actor_loss
            + value_coef * critic_loss
            - entropy_coef * entropy
        )

        actor_losses.append(
            float(actor_loss.item())
        )

        critic_losses.append(
            float(critic_loss.item())
        )

        entropy_values.append(
            float(entropy.item())
        )

        total_losses.append(
            float(total_loss.item())
        )

    # --------------------------------------------------------
    # Return update statistics
    # --------------------------------------------------------

    return {
        "actor_loss": float(
            np.mean(actor_losses)
        ),

        "critic_loss": float(
            np.mean(critic_losses)
        ),

        "entropy": float(
            np.mean(entropy_values)
        ),

        "total_loss": float(
            np.mean(total_losses)
        ),

        "mean_reward": float(
            np.mean(rewards)
        ),

        "mean_advantage": float(
            advantages.mean().item()
        ),

        "mean_return": float(
            returns.mean().item()
        ),

        "buffer_size": len(buffer)
    }


