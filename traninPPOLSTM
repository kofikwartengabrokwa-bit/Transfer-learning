        ):
            raise ValueError(
                f"Expected sequence shape "
                f"({LSTM_SEQUENCE_LENGTH}, "
                f"{LSTM_INPUT_SIZE}), "
                f"got {sequence.shape}"
            )

        sequence = torch.tensor(
            sequence,
            dtype=torch.float32
        ).unsqueeze(0)

    elif sequence.ndim == 3:

        if sequence.shape != (
            1,
            LSTM_SEQUENCE_LENGTH,
            LSTM_INPUT_SIZE
        ):
            raise ValueError(
                f"Expected sequence shape "
                f"(1, {LSTM_SEQUENCE_LENGTH}, "
                f"{LSTM_INPUT_SIZE}), "
                f"got {sequence.shape}"
            )

        sequence = torch.tensor(
            sequence,
            dtype=torch.float32
        )

    else:

        raise ValueError(
            f"Expected 2-D or 3-D sequence, "
            f"got {sequence.ndim}-D input"
        )

    with torch.no_grad():

        prediction = lstm_model(
            sequence
        )

    prediction = prediction.squeeze(0).cpu().numpy()

    return prediction.astype(
        np.float32
    )


