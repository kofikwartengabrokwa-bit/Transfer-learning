class LSTMStateHistory:

    def __init__(
        self,
        lstm_model,
        sequence_length=LSTM_SEQUENCE_LENGTH,
        state_dim=LSTM_STATE_DIM
    ):

        self.lstm_model = lstm_model
        self.sequence_length = sequence_length
        self.state_dim = state_dim

        self.history = None


    # --------------------------------------------------------
    # Reset history
    # --------------------------------------------------------

    def reset(
        self,
        initial_history=None
    ):

        if initial_history is None:

            self.history = np.zeros(
                (
                    self.sequence_length,
                    self.state_dim
                ),
                dtype=np.float32
            )

        else:

            initial_history = np.asarray(
                initial_history,
                dtype=np.float32
            )

            if initial_history.shape != (
                self.sequence_length,
                self.state_dim
            ):

                raise ValueError(
                    "Initial history must have shape "
                    f"({self.sequence_length}, "
                    f"{self.state_dim}). "
                    f"Received {initial_history.shape}."
                )

            self.history = (
                initial_history.copy()
            )

        return self.history.copy()


    # --------------------------------------------------------
    # Add ACTUAL measured observation
    # --------------------------------------------------------

    def add_observation(
        self,
        observation
    ):

        observation = np.asarray(
            observation,
            dtype=np.float32
        )

        if observation.shape != (
            self.state_dim,
        ):

            raise ValueError(
                "Observation must have shape "
                f"({self.state_dim},). "
                f"Received {observation.shape}."
            )

        if not np.isfinite(
            observation
        ).all():

            raise ValueError(
                "Observation contains "
                "non-finite values."
            )

        self.history = np.concatenate(
            [
                self.history[1:],
                observation.reshape(
                    1,
                    -1
                )
            ],
            axis=0
        )

        return self.history.copy()


    # --------------------------------------------------------
    # Predict next state using LSTM
    # --------------------------------------------------------

    def predict_next_state(self):

        history_tensor = torch.tensor(
            self.history,
            dtype=torch.float32,
            device=DEVICE
        ).unsqueeze(0)

        self.lstm_model.eval()

        with torch.no_grad():

            prediction = (
                self.lstm_model(
                    history_tensor
                )
            )

        prediction = (
            prediction
            .squeeze(0)
            .cpu()
            .numpy()
            .astype(
                np.float32
            )
        )

        if prediction.shape != (
            self.state_dim,
        ):

            raise ValueError(
                "LSTM prediction has incorrect "
                f"shape: {prediction.shape}"
            )

        if not np.isfinite(
            prediction
        ).all():

            raise ValueError(
                "LSTM prediction contains "
                "non-finite values."
            )

        return prediction


    # --------------------------------------------------------
    # Return current history
    # --------------------------------------------------------

    def get_history(self):

        return self.history.copy()


