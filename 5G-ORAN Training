def load_sqlite_dataset():

    if not DATASET_PATH.exists():
        raise FileNotFoundError(
            f"Dataset not found:\n{DATASET_PATH}"
        )

    connection = sqlite3.connect(DATASET_PATH)

    tables = pd.read_sql(
        "SELECT name FROM sqlite_master "
        "WHERE type='table';",
        connection
    )

    print("\nAvailable tables:")
    print(tables)

    df = pd.read_sql(
        f"SELECT * FROM {TABLE_NAME}",
        connection
    )

    connection.close()

    print("\nDataset shape:", df.shape)
    print("\nDataset columns:")
    print(df.columns.tolist())

    return df


def find_column(df, candidates):

    normalized = {
        str(c).lower().replace("_", "").replace("-", ""): c
        for c in df.columns
    }

    for candidate in candidates:

        key = (
            candidate
            .lower()
            .replace("_", "")
            .replace("-", "")
        )

        if key in normalized:
            return normalized[key]

    return None


def select_kpi_features(df):

    candidates = {

        "sinr": [
            "sinr",
            "dlSinr",
            "dlsinr",
        ],

        "bler": [
            "bler",
            "dlBler",
            "dlbler",
        ],

        "mcs": [
            "mcs",
            "dlMcs",
            "dlmcs",
        ],

        "cqi": [
            "cqi",
            "dlCqi",
            "dlcqi",
        ],

        "rsrp": [
            "rsrp",
            "dlRsrp",
            "dlrsrp",
        ],
    }

    selected = {}

    for name, candidates_list in candidates.items():

        col = find_column(
            df,
            candidates_list
        )

        if col is not None:
            selected[name] = col

    print("\nSelected KPI columns:")
    print(selected)

    if len(selected) < 5:

        print(
            "\nWARNING: Fewer than five predefined "
            "KPI columns were found."
        )

        numeric_cols = df.select_dtypes(
            include=np.number
        ).columns.tolist()

        exclude = {
            "rnti",
            "id",
            "timestamp",
        }

        numeric_cols = [
            c for c in numeric_cols
            if str(c).lower() not in exclude
        ]

        if len(numeric_cols) >= 5:

            selected = {
                f"kpi_{i}": numeric_cols[i]
                for i in range(5)
            }

            print(
                "\nUsing five numerical columns "
                "automatically:"
            )
            print(selected)

    if len(selected) < 5:

        raise ValueError(
            "Unable to identify at least five "
            "numerical KPI features. "
            "Print the columns above and edit "
            "the candidate lists."
        )

    selected = dict(
        list(selected.items())[:5]
    )

    data = df[
        list(selected.values())
    ].copy()

    data = data.apply(
        pd.to_numeric,
        errors="coerce"
    )

    data = data.replace(
        [np.inf, -np.inf],
        np.nan
    )

    data = data.interpolate(
        limit_direction="both"
    )

    data = data.fillna(
        data.median()
    )

    return data.astype(np.float32)


