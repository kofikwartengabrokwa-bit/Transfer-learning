# ============================================================
# 1. LOAD SQLITE DATASET
# ============================================================

def load_sqlite_dataset(
    db_path=DATASET_PATH,
    table_name=TABLE_NAME,
):
    """
    Load the O-RAN dataset from the SQLite database.

    Returns
    -------
    pd.DataFrame
        Complete dataset table.
    """

    db_path = Path(db_path)

    if not db_path.exists():
        raise FileNotFoundError(
            f"Dataset not found: {db_path}"
        )

    conn = sqlite3.connect(str(db_path))

    try:
        df = pd.read_sql_query(
            f"SELECT * FROM {table_name}",
            conn,
        )
    finally:
        conn.close()

    if df.empty:
        raise ValueError(
            f"Table '{table_name}' is empty."
        )

    return df


# ============================================================
# 2. SELECT KPI FEATURES
# ============================================================

def select_kpi_features(df):
    """
    Select the five KPI features used by the LSTM.

    Selected features:
        SINR
        BLER
        MCS
        CQI
        RSRP

    Returns
    -------
    features : np.ndarray
        Numerical KPI matrix.
    kpi_columns : dict
        Mapping between logical KPI names and database columns.
    """

    columns_lower = {
        str(col).lower(): col
        for col in df.columns
    }

    def find_column(candidates):

        # Exact match first
        for candidate in candidates:

            if candidate.lower() in columns_lower:
                return columns_lower[
                    candidate.lower()
                ]

        # Partial match second
        for col_lower, original_col in columns_lower.items():

            for candidate in candidates:

                if candidate.lower() in col_lower:
                    return original_col

        return None

    kpi_columns = {

        "sinr": find_column([
            "sinr",
            "dlSinr",
            "dl_sinr",
        ]),

        "bler": find_column([
            "dlBler",
            "bler",
            "dl_bler",
        ]),

        "mcs": find_column([
            "dlMcs",
            "mcs",
            "dl_mcs",
        ]),

        "cqi": find_column([
            "cqi",
            "dlCqi",
            "dl_cqi",
        ]),

        "rsrp": find_column([
            "rsrp",
            "dlRsrp",
            "dl_rsrp",
        ]),
    }

    missing = [
        name
        for name, column in kpi_columns.items()
        if column is None
    ]

    if missing:

        raise ValueError(
            "The following KPI columns could not be found: "
            f"{missing}\n\n"
            f"Available columns:\n{list(df.columns)}"
        )

    print("\nSelected KPI columns:")
    print(kpi_columns)

    selected_columns = [
        kpi_columns["sinr"],
        kpi_columns["bler"],
        kpi_columns["mcs"],
        kpi_columns["cqi"],
        kpi_columns["rsrp"],
    ]

    features = (
        df[selected_columns]
        .apply(pd.to_numeric, errors="coerce")
        .replace(
            [np.inf, -np.inf],
            np.nan,
        )
        .dropna()
        .to_numpy(
            dtype=np.float32
        )
    )

    return features, kpi_columns


# ============================================================
# 3. CREATE LSTM SEQUENCES
# ============================================================

def create_sequences(
    features,
    seq_len=SEQ_LEN,
):
    """
    Create sliding-window sequences for LSTM prediction.

    For each time step:

        X[t] = observations [t, ..., t+seq_len-1]

        y[t] = observation [t+seq_len]

    Parameters
    ----------
    features : np.ndarray
        KPI feature matrix with shape (N, 5).

    seq_len : int
        Number of historical observations in each
        LSTM input sequence.

    Returns
    -------
    X : np.ndarray
        Shape: (N-seq_len, seq_len, 5)

    y : np.ndarray
        Shape: (N-seq_len, 5)
    """

    if features.ndim != 2:
        raise ValueError(
            "features must be a 2-D array."
        )

    if features.shape[1] != 5:
        raise ValueError(
            "Expected exactly 5 KPI features, "
            f"but received {features.shape[1]}."
        )

    if len(features) <= seq_len:
        raise ValueError(
            f"Number of observations ({len(features)}) "
            f"must be greater than sequence length "
            f"({seq_len})."
        )

    X = []
    y = []

    for i in range(
        len(features) - seq_len
    ):

        X.append(
            features[
                i:i + seq_len
            ]
        )

        y.append(
            features[
                i + seq_len
            ]
        )

    X = np.asarray(
        X,
        dtype=np.float32,
    )

    y = np.asarray(
        y,
        dtype=np.float32,
    )

    print(
        f"\nLSTM input: {X.shape}"
    )

    print(
        f"LSTM target: {y.shape}"
    )

    return X, y


# ============================================================
# 4. COMPATIBILITY FUNCTION
# ============================================================

def load_lstm_data(
    db_path=DATASET_PATH,
    table_name=TABLE_NAME,
    seq_len=SEQ_LEN,
):
    """
    Convenience function for standalone LSTM training.
    """

    df = load_sqlite_dataset(
        db_path=db_path,
        table_name=table_name,
    )

    features, kpi_columns = (
        select_kpi_features(df)
    )

    X, y = create_sequences(
        features,
        seq_len=seq_len,
    )

    return X, y, kpi_columns


