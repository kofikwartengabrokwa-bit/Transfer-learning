def create_sequences(data):

    scaler = StandardScaler()

    values = scaler.fit_transform(
        data.values
    )

    X = []
    Y = []

    for i in range(
        len(values) - SEQ_LEN
    ):

        X.append(
            values[i:i + SEQ_LEN]
        )

        Y.append(
            values[i + SEQ_LEN]
        )

    X = np.asarray(
        X,
        dtype=np.float32
    )

    Y = np.asarray(
        Y,
        dtype=np.float32
    )

